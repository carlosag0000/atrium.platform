# Images uploaded from the dashboard (Website → Media, stored in /uploads). Only images are served; nothing here runs.
Options -Indexes
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
</IfModule>
